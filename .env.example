# MyMindIL Environment Configuration
# Copy this file to .env and fill in your values

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False

# Database (PostgreSQL with pgvector)
# Supabase/Neon/Render often provide: postgres://... or postgresql://...
# This app will normalize those to: postgresql+psycopg://... (psycopg v3)
DATABASE_URL=postgresql://user:password@host:5432/mymindil

# Telegram Bot
TELEGRAM_TOKEN=your-telegram-bot-token-from-botfather
# For production (Render): https://yourdomain.onrender.com/webhook
TELEGRAM_WEBHOOK_URL=
# Optional: Bot username (without @) for web login fallback
TELEGRAM_BOT_USERNAME=

# Google AI
GOOGLE_API_KEY=your-google-ai-api-key
# Optional: override Gemini models if needed
GEMINI_TEXT_MODEL=gemini-pro
GEMINI_VISION_MODEL=gemini-pro-vision

# Optional: Sentry for error tracking
SENTRY_DSN=

# Optional: Redis for rate limiting
REDIS_URL=

# Environment
ENVIRONMENT=production
PORT=5000
